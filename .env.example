# Copie este arquivo para `.env` e preencha antes de rodar em produção.
# Para validar a lógica de negócio sem nenhuma credencial, use o dry-run:
#   python tests/test_dry_run.py

# --- Agregador bancário ---
# "arquivo" (recomendado, grátis) | "pluggy" | "belvo" (ver src/aggregator.py).
# Pluggy comercial custa a partir de R$2.500/mês e Belvo a partir de
# US$1.000/mês — o Meu Pluggy gratuito NÃO serve aqui: é só pra pessoa física
# usando dados próprios sem fins comerciais (as contas do negócio são PJ/CNPJ
# e o uso é comercial). Por isso o modo "arquivo" é o recomendado: lê extratos
# OFX exportados manualmente do internet banking (ver EXTRATOS_DIR abaixo).
AGGREGATOR=arquivo

# Modo "arquivo": pasta onde ficam os extratos .ofx, um arquivo por conta,
# nomeado com a conta_key (ex: extratos/AZEVEDO_SICOOB.ofx). Alguém precisa
# baixar o extrato do internet banking de cada uma das 6 contas e salvar
# aqui antes do Cenário 1 rodar (06:00). Sem custo nenhum.
EXTRATOS_DIR=extratos

# Pluggy (só se decidir pagar o plano comercial): dashboard.pluggy.ai ->
# Applications -> sua aplicação (Client ID / Client Secret na tela de detalhes)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Belvo (alternativa paga): dashboard.belvo.com -> Secrets
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=

# Só usados nos modos "pluggy"/"belvo": IDs de conexão ("link"/"item") de
# cada uma das 6 contas reais no agregador escolhido. Cole o id de cada conta
# aqui (ver TODO em config.py — confirmar se contas com mesma agência entre
# unidades precisam de conexões separadas).
LINK_AZEVEDO_SICOOB=
LINK_AZEVEDO_CAIXA=
LINK_AZEVEDO_ITAU=
LINK_PARKLAGOS_CAIXA=
LINK_PARKLAGOS_ITAU=
LINK_PORDOSOL_CAIXA=

# --- Google Sheets ---
# Caminho do arquivo JSON da service account (Google Cloud Console -> IAM &
# Admin -> Service Accounts -> Keys -> Add key -> JSON). Compartilhe a
# planilha com o e-mail "client_email" desse JSON.
GOOGLE_CREDENTIALS_FILE=credentials.json
# ID da planilha: pedaço da URL entre /d/ e /edit
# https://docs.google.com/spreadsheets/d/ESTE_PEDAÇO_AQUI/edit
SPREADSHEET_ID=
# Opcional: ID da pasta "Financeiro Uploads" no Google Drive. Se vazio,
# o sistema localiza ou cria uma pasta com esse nome para persistir uploads.
DRIVE_UPLOADS_FOLDER_ID=

# --- WhatsApp Business Cloud API (Meta) ---
# Meta for Developers -> seu app -> WhatsApp -> API Setup
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# Telefone do gestor que recebe os alertas/relatórios (formato internacional,
# ex: 5522988880000 — sem espaços, +, ou traços)
GESTOR_PHONE=

# --- E-mail (SMTP com senha de app do Gmail/Outlook) ---
# Notificações saem por WhatsApp E e-mail ao mesmo tempo (ver src/notificar.py).
# Gmail: myaccount.google.com/apppasswords (precisa 2FA ativado) -> gera uma
# senha de 16 letras específica pra este sistema, não é a senha normal da conta.
# Outlook: account.microsoft.com/security -> Senhas de aplicativo.
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
# smtp.gmail.com (Gmail) ou smtp.office365.com (Outlook/Hotmail)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
# E-mail do gestor que recebe os alertas/relatórios
GESTOR_EMAIL=

# --- Claude API (Anthropic) ---
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
